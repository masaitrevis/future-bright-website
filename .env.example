# =============================================================================
# Future Bright Website — environment variables
# Copy to .env (NEVER commit .env) and fill in real values.
# =============================================================================

# ---- Database ----
# Render Postgres connection string (required).
POSTGRES_URL=postgresql://user:password@dpg-xxxxxxxx.render.com:5432/dbname
# Optional PEM CA certificate for Postgres TLS. If unset and the host contains
# render.com, the app uses ssl with rejectUnauthorized:false and logs a warning
# (Render proxy constraint).
DATABASE_CA_CERT=

# ---- App ----
# Canonical public origin of the site. NEVER derived from the Host header.
# Used to build absolute download URLs.
APP_BASE_URL=https://future-bright-website.onrender.com

# ---- NCBA API ----
# NCBA C2B API base URL.
NCBA_BASE_URL=https://c2bapis.ncbagroup.com
# API Basic-auth credentials (from the NCBA signed letter).
NCBA_USERNAME=your-ncba-api-username
NCBA_PASSWORD=your-ncba-api-password
# Paybill number — 880100 for NCBA Till.
NCBA_PAYBILL_NO=880100
# Account/till reference sent as AccountNo in STK push requests.
NCBA_ACCOUNT_NO=your-till-account-reference
# Mobile network for STK push.
NCBA_NETWORK=Safaricom

# ---- NCBA Notifications ----
# Credentials WE choose and give to NCBA for the payment notification webhook.
NCBA_NOTIFY_USERNAME=choose-a-webhook-username
NCBA_NOTIFY_PASSWORD=choose-a-strong-webhook-password
# Secret used to compute/verify the webhook Hash field (per NCBA guide).
NCBA_NOTIFY_SECRET=choose-a-strong-webhook-secret

# ---- Admin ----
# Admin login username.
ADMIN_USERNAME=admin
# Preferred: scrypt hash of the admin password in saltHex:hashHex format.
# Generate with: node -e "const c=require('crypto');const s=c.randomBytes(16);console.log(s.toString('hex')+':'+c.scryptSync('your-password',s,64).toString('hex'))"
ADMIN_PASSWORD_HASH=
# Fallback plaintext admin password (timing-safe compare; logs a warning).
# Use only if ADMIN_PASSWORD_HASH is not set.
ADMIN_PASSWORD=
# HMAC secret for signing admin tokens (use a long random string).
ADMIN_TOKEN_SECRET=generate-a-long-random-secret
